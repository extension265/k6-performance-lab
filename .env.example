# Copy to .env to change how the stack starts (docker compose reads .env automatically).
# Then run: npm run stack:up

# Default for every seeded bottleneck: on | off
BOTTLENECK_MODE=on

# Per-bottleneck overrides (leave empty to follow BOTTLENECK_MODE)
BOTTLENECK_POOL=          # on: DB pool 5, off: 20
BOTTLENECK_INDEX=         # on: no index on payments.order_id, off: index created at startup
BOTTLENECK_N_PLUS_ONE=    # on: N+1 queries in GET /orders/:id, off: single JOIN
BOTTLENECK_BCRYPT=        # on: bcrypt cost 12, off: cost 8

# Simulated payment provider
PROVIDER_LATENCY_MIN_MS=50
PROVIDER_LATENCY_MAX_MS=150
DECLINE_RATE=0.02
